<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Bookshelf API Suite">
    <test name="Auth Group">
        <groups>
            <run>
                <include name="auth"/>
            </run>
        </groups>
        <classes>
            <class name="com.bookshelf.tests.AuthTests"/>
        </classes>
    </test>

    <test name="Books Group">
        <groups>
            <run>
                <include name="books"/>
            </run>
        </groups>
        <classes>
            <class name="com.bookshelf.tests.BookTests"/>
        </classes>
    </test>

    <test name="Edit Requests Group">
        <groups>
            <run>
                <include name="edit-requests"/>
            </run>
        </groups>
        <classes>
            <class name="com.bookshelf.tests.EditRequestTests"/>
        </classes>
    </test>
</suite>